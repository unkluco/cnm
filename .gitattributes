# Normalize text files to LF in the repository.
* text=auto eol=lf

# Unity text assets (YAML). Must stay text: Edit > Project Settings > Editor > Asset Serialization = Force Text.
*.unity         text eol=lf
*.prefab        text eol=lf
*.asset         text eol=lf
*.mat           text eol=lf
*.anim          text eol=lf
*.controller    text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.meta          text eol=lf
*.inputactions  text eol=lf
*.asmdef        text eol=lf
*.asmref        text eol=lf
*.cs            text eol=lf diff=csharp
*.shader        text eol=lf
*.hlsl          text eol=lf
*.uss           text eol=lf
*.uxml          text eol=lf

# Binary files.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.psd   binary
*.tga   binary
*.tif   binary
*.exr   binary
*.hdr   binary
*.fbx   binary
*.obj   binary
*.blend binary
*.glb   binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.ttf   binary
*.otf   binary
*.docx  binary
*.pdf   binary
*.zip   binary
